# =============================================================================
# Modest storefront. Secrets live in Lovable Cloud for the edge functions.
# Do NOT prefix PRINTIFY_* or STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET with VITE_.
# Do NOT commit real secrets.
# =============================================================================

# The browser reaches catalog, products, preorders, and checkout through
# VITE_SUPABASE_URL/functions/v1/. These two values are public project config.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Lovable Cloud secrets (edge functions only, already the deploy target) ---
# PRINTIFY_API_TOKEN          required. Catalog + paid-order handoff. Not in the repo.
# PRINTIFY_SHOP_ID=8464572    catalog shop. Do not use 8464467 — that shop is empty.
# STRIPE_SECRET_KEY           required. Modest's Stripe account. Live key before launch.
# STRIPE_WEBHOOK_SECRET       required. Signing secret for checkout.session.completed.
# PUBLIC_ORIGIN=https://bemoremodest.com
#                             required. Stripe success and cancel URLs. Never from a header.
# STRIPE_AUTOMATIC_TAX        optional. Defaults to on. Set false only as an explicit
#                             decision. Do not use it to hide a missing tax address.
# STRIPE_TAX_CODE             optional. Apparel tax code. Unset uses the Stripe account default.
# PRINTIFY_AUTO_SUBMIT=false  optional. Default keeps Printify orders as drafts.
# PRINTIFY_SKIP_SKUS          optional comma-separated legacy SKUs.
# PRINTIFY_API_BASE           optional. Default https://api.printify.com/v1
# PRINTIFY_CACHE_TTL_MS       optional. Default 300000

# Publishable key is public. This Checkout redirect flow does not put it in the bundle.
# VITE_STRIPE_PUBLISHABLE_KEY=

# --- Analytics (optional, client) ---
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
