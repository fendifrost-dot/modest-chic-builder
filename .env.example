# =============================================================================
# Modest storefront — server secrets stay off the client.
# Do NOT prefix PRINTIFY_* or STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET with VITE_.
# Do NOT commit real secrets. Copy to .env for local `npm run dev` / `npm start`.
# =============================================================================

# Pre-orders are not env vars. Edit content/preorders.json.
# Leave title, expectedShip, and priceCents empty until the Founder fills them in.

# --- Printify catalog + paid-order handoff (server only) ---
# Create a personal access token in Printify: Connections → API.
# The token is set on the host at deploy time. Do not commit it.
PRINTIFY_API_TOKEN=
# Catalog shop. The server uses 8464572 when this is unset.
# Do not use 8464467 — that shop is empty.
PRINTIFY_SHOP_ID=8464572
# Optional
# PRINTIFY_API_BASE=https://api.printify.com/v1
# PRINTIFY_CACHE_TTL_MS=300000
# Comma-separated legacy jacket SKUs to drop even if the title is not a jacket.
# PRINTIFY_SKIP_SKUS=
# Set true only when paid orders should be sent to production automatically.
# PRINTIFY_AUTO_SUBMIT=false

# --- Stripe Checkout (Modest's existing Stripe account, server only) ---
# Secret key: sk_test_... or sk_live_... never hardcode it.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Publishable key is public, but this Checkout redirect flow does not put it in the bundle.
# Keep it for a future Payment Element. Never put the secret key in a VITE_ variable.
VITE_STRIPE_PUBLISHABLE_KEY=

# Public site origin used when a request host is unavailable. Checkout builds its
# success URL from the incoming request host.
# SITE_URL=https://bemoremodest.com

# --- Lovable Cloud (Supabase) — auto-managed, not the catalog or checkout ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Analytics (optional, client) ---
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
